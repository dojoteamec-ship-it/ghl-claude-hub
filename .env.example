# Plantilla de variables de entorno de GHL Claude Hub.
# Copia este archivo a .env.local y llena los valores en tu máquina.
# Nunca pegues estos valores en el chat ni hagas commit de .env.local.

# --- GoHighLevel ---------------------------------------------------------------
# URL base de la API oficial de GHL. Normalmente no se cambia.
GHL_API_BASE=https://services.leadconnectorhq.com
# Valor del header Version de la API. Verificado en la Etapa 3: v3 (ver docs/DECISIONES.md).
GHL_API_VERSION=v3
# Private Integration Token de cada subcuenta: una variable por alias de config/subcuentas.json,
# con el alias en mayúsculas. Ejemplo: alias "prueba" -> GHL_PIT_PRUEBA.
GHL_PIT_PRUEBA=
# GHL_PIT_CLIENTE1=

# --- Telegram (Etapa 6) ----------------------------------------------------------
# Token del bot de clientes que entrega @BotFather.
TELEGRAM_BOT_TOKEN=
# Tu ID numérico de Telegram; el bot te reconoce como admin.
TELEGRAM_ADMIN_ID=
# Texto aleatorio largo para validar el header X-Telegram-Bot-Api-Secret-Token del webhook (Etapa 7).
TELEGRAM_WEBHOOK_SECRET=

# --- Modelos -----------------------------------------------------------------------
# API key de la Console de Anthropic para el bot (no sirve el plan Pro de claude.ai).
ANTHROPIC_API_KEY=
# API key de OpenAI, solo para transcribir notas de voz (opcional).
OPENAI_API_KEY=
# Modelo de transcripción; por defecto gpt-transcribe (gpt-4o-mini-transcribe quedó obsoleto).
# OPENAI_MODELO_TRANSCRIPCION=gpt-transcribe

# --- Supabase (Etapa 6) ------------------------------------------------------------
# URL del proyecto de Supabase del bot (proyecto propio, separado de otros sistemas).
SUPABASE_URL=
# Service role key: solo la usa el servidor del bot, nunca un cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cifrado -----------------------------------------------------------------------
# Clave de 32 bytes en base64 para cifrar los PIT con AES-256-GCM. pnpm bot:configurar la genera.
BOT_ENCRYPTION_KEY=
