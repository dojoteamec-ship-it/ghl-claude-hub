{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./config/subcuentas.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./config/subcuentas.json)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat config/subcuentas.json)",
      "Bash(printenv*)",
      "Bash(env)"
    ],
    "ask": [
      "mcp__ghl-oficial__execute_operation",
      "mcp__ghl-api__crear_contacto",
      "mcp__ghl-api__upsert_contacto",
      "mcp__ghl-api__actualizar_contacto",
      "mcp__ghl-api__agregar_tags",
      "mcp__ghl-api__quitar_tags",
      "mcp__ghl-api__crear_nota",
      "mcp__ghl-api__crear_tarea",
      "mcp__ghl-api__borrar_contacto",
      "mcp__ghl-api__crear_oportunidad",
      "mcp__ghl-api__actualizar_oportunidad",
      "mcp__ghl-api__mover_etapa",
      "mcp__ghl-api__cambiar_estado_oportunidad",
      "mcp__ghl-api__borrar_oportunidad",
      "mcp__ghl-api__enviar_mensaje",
      "mcp__ghl-api__crear_cita",
      "mcp__ghl-api__actualizar_cita",
      "mcp__ghl-api__inscribir_en_workflow",
      "mcp__ghl-api__sacar_de_workflow"
    ],
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm secretos)",
      "Bash(pnpm verificar)",
      "mcp__ghl-oficial__search_operations",
      "mcp__ghl-oficial__describe_operation",
      "mcp__ghl-oficial__list_locations",
      "mcp__ghl-api__listar_subcuentas",
      "mcp__ghl-api__subcuenta_activa",
      "mcp__ghl-api__seleccionar_subcuenta",
      "mcp__ghl-api__comparar_subcuentas",
      "mcp__ghl-api__exportar",
      "mcp__ghl-api__buscar_contactos",
      "mcp__ghl-api__obtener_contacto",
      "mcp__ghl-api__buscar_duplicado",
      "mcp__ghl-api__listar_notas",
      "mcp__ghl-api__listar_tareas",
      "mcp__ghl-api__listar_pipelines",
      "mcp__ghl-api__buscar_oportunidades",
      "mcp__ghl-api__oportunidades_sin_movimiento",
      "mcp__ghl-api__obtener_oportunidad",
      "mcp__ghl-api__buscar_conversaciones",
      "mcp__ghl-api__leer_mensajes",
      "mcp__ghl-api__listar_calendarios",
      "mcp__ghl-api__citas_por_rango",
      "mcp__ghl-api__horarios_libres",
      "mcp__ghl-api__obtener_subcuenta",
      "mcp__ghl-api__listar_campos_personalizados",
      "mcp__ghl-api__listar_valores_personalizados",
      "mcp__ghl-api__listar_tags",
      "mcp__ghl-api__listar_workflows",
      "mcp__ghl-api__envios_formularios",
      "mcp__ghl-api__envios_encuestas",
      "mcp__ghl-api__listar_usuarios",
      "mcp__ghl-api__listar_transacciones",
      "mcp__ghl-api__listar_ordenes",
      "mcp__ghl-api__listar_facturas",
      "mcp__ghl-api__listar_productos",
      "mcp__ghl-api__resumen_briefing",
      "mcp__ghl-api__resumen_pipeline",
      "mcp__ghl-api__auditoria_subcuenta",
      "mcp__ghl-api__leads_sin_respuesta"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/scripts/barra-estado.mjs\""
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__ghl-(api|oficial)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/registro-acciones.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__ghl-(api|oficial)__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/registro-acciones.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
