{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./config/subcuentas.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./config/subcuentas.json)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat config/subcuentas.json)",
      "Bash(printenv*)",
      "Bash(env)"
    ],
    "ask": ["mcp__ghl-oficial__execute_operation"],
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm secretos)",
      "Bash(pnpm verificar)",
      "mcp__ghl-oficial__search_operations",
      "mcp__ghl-oficial__describe_operation",
      "mcp__ghl-oficial__list_locations"
    ]
  }
}
